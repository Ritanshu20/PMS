# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL connection (app role, NOT the superuser)
DATABASE_URL=postgres://pms_app:CHANGE_ME@localhost:5432/pms

# Rate limits: login/register/refresh/logout, anonymous requests, logged-in users
AUTH_THROTTLE_RATE=20/min
ANON_THROTTLE_RATE=60/min
USER_THROTTLE_RATE=600/min

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Production only (used when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# BEHIND_HTTPS_PROXY=False

# Session login page: failed attempts allowed per IP in 15 minutes
LOGIN_FAILURE_LIMIT=10

# seed_demo password for the demo users (local demo only)
DEMO_PASSWORD=demo-pass-2026
